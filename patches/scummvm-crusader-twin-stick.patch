+#include <cxxtest/TestSuite.h>
+#include "engines/ultima/ultima8/world/actors/cru_twin_stick_math.h"
+
+class CruTwinStickMathTestSuite : public CxxTest::TestSuite {
+public:
+	void testScreenCardinalAimAngles() {
+		using Ultima::Ultima8::CruTwinStickMath;
+		TS_ASSERT_EQUALS(CruTwinStickMath::aimAngle(10000, 0), 4500);
+		TS_ASSERT_EQUALS(CruTwinStickMath::aimAngle(-10000, 0), 22500);
+		TS_ASSERT_EQUALS(CruTwinStickMath::aimAngle(0, -10000), 31500);
+		TS_ASSERT_EQUALS(CruTwinStickMath::aimAngle(0, 10000), 13500);
+	}
+
+	void testScreenDiagonalIsUnprojectedForIsometricWorld() {
+		using Ultima::Ultima8::CruTwinStickMath;
+		TS_ASSERT_EQUALS(CruTwinStickMath::aimAngle(10000, -10000), 34157);
+		TS_ASSERT_EQUALS(CruTwinStickMath::aimAngle(10000, 10000), 10843);
+	}
+
+	void testMotionSpeedDoesNotDependOnStickMagnitude() {
+		using Ultima::Ultima8::CruTwinStickMath;
+		int32 dx, dy;
+		CruTwinStickMath::movement(-7000, 0, 4, dx, dy);
+		TS_ASSERT_EQUALS(dx, -4);
+		TS_ASSERT_EQUALS(dy, 4);
+		CruTwinStickMath::movement(-32768, 0, 4, dx, dy);
+		TS_ASSERT_EQUALS(dx, -4);
+		TS_ASSERT_EQUALS(dy, 4);
+		CruTwinStickMath::movement(0, -32768, 4, dx, dy);
+		TS_ASSERT_EQUALS(dx, -8);
+		TS_ASSERT_EQUALS(dy, -8);
+		CruTwinStickMath::movement(0, 0, 4, dx, dy);
+		TS_ASSERT_EQUALS(dx, 0);
+		TS_ASSERT_EQUALS(dy, 0);
+	}
+
+	void testPoseRoundingWrapsAndHonorsDirectionCount() {
+		using Ultima::Ultima8::CruTwinStickMath;
+		TS_ASSERT_EQUALS(CruTwinStickMath::bodyDirection(35999, true), 0);
+		TS_ASSERT_EQUALS(CruTwinStickMath::bodyDirection(35999, false), 0);
+		TS_ASSERT_EQUALS(CruTwinStickMath::bodyDirection(6500, true), 2);
+		TS_ASSERT_EQUALS(CruTwinStickMath::bodyDirection(6500, false), 3);
+	}
+
+	void testPoseHysteresisHoldsAcrossSectorJitterAndWraps() {
+		using Ultima::Ultima8::CruTwinStickMath;
+		const int cases[][4] = {
+			{2200, 1, 0, 0}, {2300, 1, 0, 0}, {2999, 1, 0, 0}, {3000, 1, 0, 2},
+			{34000, 1, 0, 0}, {32999, 1, 0, 14}, {2300, 1, 2, 2}, {1499, 1, 2, 0},
+			{1100, 0, 0, 0}, {1200, 0, 0, 0}, {1500, 0, 0, 1}, {35999, 0, 0, 0},
+			{2250, 1, 1, 2}, {9000, 0, -1, 4}
+		};
+		for (uint i = 0; i < ARRAYSIZE(cases); ++i)
+			TS_ASSERT_EQUALS(CruTwinStickMath::stableBodyDirection(cases[i][0], cases[i][1], cases[i][2]), cases[i][3]);
+	}
+};
