+#ifndef ULTIMA8_WORLD_ACTORS_CRU_STICK_INPUT_H
+#define ULTIMA8_WORLD_ACTORS_CRU_STICK_INPUT_H
+
+#include "common/scummsys.h"
+#include "common/util.h"
+
+namespace Ultima {
+namespace Ultima8 {
+
+class CruStickInput {
+public:
+	enum HalfAxis { LEFT, RIGHT, UP, DOWN };
+
+	CruStickInput(int deadzone = 15, int walkThreshold = 45, int hysteresis = 5, bool walkingZone = true) {
+		_walkingZone = walkingZone;
+		_deadzone = CLIP(deadzone, 1, 98);
+		_walkThreshold = CLIP(walkThreshold, _deadzone + 1, 100);
+		int maxHysteresis = walkingZone ? MIN(_deadzone - 1, _walkThreshold - _deadzone - 1) : _deadzone - 1;
+		_hysteresis = CLIP(hysteresis, 0, maxHysteresis);
+		reset();
+	}
+
+	void reset() {
+		for (int &axis : _axes)
+			axis = 0;
+		_active = false;
+		_walking = false;
+	}
+
+	void update(HalfAxis axis, int position) {
+		_axes[axis] = CLIP(position, 0, 32767);
+		if (_axes[axis] > 0)
+			_axes[axis ^ 1] = 0;
+		int64 x = getX();
+		int64 y = getY();
+		int64 radiusSquared = x * x + y * y;
+		_active = aboveThreshold(radiusSquared, _deadzone - (_active ? _hysteresis : 0));
+		_walking = _walkingZone && _active && aboveThreshold(radiusSquared, _walkThreshold - (_walking ? _hysteresis : 0));
+	}
+
+	int getX() const { return _axes[RIGHT] - _axes[LEFT]; }
+	int getY() const { return _axes[DOWN] - _axes[UP]; }
+	bool isActive() const { return _active; }
+	bool isWalking() const { return _walking; }
+
+private:
+	static bool aboveThreshold(int64 radiusSquared, int percent) {
+		int64 threshold = 32767 * percent / 100;
+		return radiusSquared >= threshold * threshold;
+	}
+
+	int _axes[4];
+	int _deadzone;
+	int _walkThreshold;
+	int _hysteresis;
+	bool _active;
+	bool _walking;
+	bool _walkingZone;
+};
+
+} // End of namespace Ultima8
+} // End of namespace Ultima
+
+#endif
