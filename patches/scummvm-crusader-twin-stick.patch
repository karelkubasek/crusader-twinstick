+
+bool CruAvatarMoverProcess::handleModernMovement() {
+	Actor *avatar = getControlledActor();
+	if (!avatar || avatar != getMainActor() || avatar->isDead() ||
+		Ultima8Engine::get_instance()->isAvatarInStasis() || avatar->getGravityPID() ||
+		!avatar->hasFlags(Item::FLG_FASTAREA)) {
+		resetStick();
+		return false;
+	}
+	if (_modernActor && _modernActor != avatar->getObjId()) {
+		resetStick();
+		return false;
+	}
+	if (!_stick.isActive() && !_modernWasActive)
+		return false;
+
+	_modernActor = avatar->getObjId();
+	Direction direction = _stick.isActive() ?
+		Direction_Get(-_stick.getY(), _stick.getX(), dirmode_8dirs) : avatar->getDir();
+	Process *animation = Kernel::get_instance()->getProcess(_modernAnimation);
+	if (!animation || animation->is_terminated())
+		_modernAnimation = 0;
+	if (_modernAnimation && (!_stick.isWalking() || direction != avatar->getDir()))
+		stopModernAnimation();
+	if (avatar->isBusy())
+		return true;
+
+	bool turned = direction != avatar->getDir();
+	avatar->setDir(direction);
+	_avatarAngle = avatar->isInCombat() ? Direction_ToCentidegrees(direction) : -1;
+	_modernWasActive = _stick.isActive();
+	if (checkOneShotMove(direction))
+		return true;
+	if (hasMovementFlags(MOVE_ATTACKING)) {
+		tryAttack();
+		if (avatar->isBusy())
+			return true;
+	}
+
+	if (_stick.isWalking()) {
+		Animation::Sequence action = Animation::walk;
+		if (avatar->isKneeling())
+			action = Animation::kneelingAdvance;
+		else if (hasMovementFlags(MOVE_RUN))
+			action = Animation::run;
+		else if (avatar->isInCombat())
+			action = Animation::advance;
+		_modernAnimation = step(action, direction);
+	} else {
+		Animation::Sequence idle = avatar->isKneeling() ? Animation::kneel :
+			(avatar->isInCombat() ? Animation::combatStand : Animation::stand);
+		if (turned || avatar->getLastAnim() != idle) {
+			avatar->setLastAnim(idle);
+			avatar->setToStartOfAnim(idle);
+		}
+	}
+	return true;
+}
+
+Point3 CruAvatarMoverProcess::getTwinStickRenderOffset() const {
+	if (!_twinStickControls || !_stick.isActive() || _modernActor != kMainActorId)
+		return Point3();
+	const ActorAnimProcess *animation = dynamic_cast<ActorAnimProcess *>(
+		Kernel::get_instance()->getProcess(_modernAnimation));
+	return animation && !animation->is_terminated() ? animation->getInPlaceRenderOffset() : Point3();
+}
+
+bool CruAvatarMoverProcess::moveTwinStickActor(Actor *avatar) {
+	int32 dx, dy;
+	int speed = avatar->isKneeling() ? 2 : hasMovementFlags(MOVE_RUN) ? 8 : 4;
+	CruTwinStickMath::movement(_stick.getX(), _stick.getY(), speed, dx, dy);
+	Point3 start = avatar->getLocation();
+	Box startBox = avatar->getWorldBox();
+	CurrentMap *map = World::get_instance()->getCurrentMap();
+	uint32 flags = avatar->getShapeInfo()->_flags;
+	Direction direction = Direction_GetWorldDir(dy, dx, dirmode_8dirs);
+	for (int attempt = 0; attempt < 3; ++attempt) {
+		Point3 end(start.x + (attempt == 2 ? 0 : dx), start.y + (attempt == 1 ? 0 : dy), start.z);
+		if (end == start)
+			continue;
+		Box endBox(end.x, end.y, end.z, startBox._xd, startBox._yd, startBox._zd);
+		PositionInfo info = map->getPositionInfo(endBox, startBox, flags, avatar->getObjId());
+		if (!info.valid || !info.supported) {
+			bool adjusted = map->scanForValidPosition(end.x, end.y, end.z, avatar, direction,
+				true, end.x, end.y, end.z);
+			if (!adjusted && !info.valid)
+				continue;
+		}
+		// Clear the edge before descending; a diagonal sweep hits the floor
+		// being stepped off. Raise first when stepping onto a higher surface.
+		if (end.z > start.z)
+			avatar->collideMove(start.x, start.y, end.z, false, false);
+		Point3 raised = avatar->getLocation();
+		avatar->collideMove(end.x, end.y, raised.z, false, false);
+		Point3 moved = avatar->getLocation();
+		if (moved.x == end.x && moved.y == end.y && moved.z != end.z)
+			avatar->collideMove(end.x, end.y, end.z, false, false);
+		if (avatar->getLocation() != start) {
+			PositionInfo support = map->getPositionInfo(avatar->getWorldBox(), startBox, flags, avatar->getObjId());
+			if (!support.supported)
+				avatar->fall();
+			return true;
+		}
+	}
+	return false;
+}
+
+int32 CruAvatarMoverProcess::getTwinStickAimAngle() const {
+	Actor *avatar = getControlledActor();
+	return _aimStick.isActive() ? CruTwinStickMath::aimAngle(_aimStick.getX(), _aimStick.getY()) :
+		_stick.isActive() ? CruTwinStickMath::aimAngle(_stick.getX(), _stick.getY()) :
+		_avatarAngle >= 0 ? _avatarAngle : Direction_ToCentidegrees(avatar->getDir());
+}
