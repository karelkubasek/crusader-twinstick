+bool CruAvatarMoverProcess::handleTwinStickMovement() {
+	Actor *avatar = getControlledActor();
+	if (!avatar || avatar != getMainActor() || avatar->isDead() ||
+		Ultima8Engine::get_instance()->isAvatarInStasis() ||
+		!avatar->hasFlags(Item::FLG_FASTAREA)) {
+		resetStick();
+		return false;
+	}
+	if (avatar->getGravityPID()) {
+		if (_modernAnimation)
+			stopModernAnimation();
+		return false;
+	}
+	bool moving = _stick.isActive();
+	bool aiming = _aimStick.isActive();
+	if (!moving && !aiming && !_modernWasActive && hasMovementFlags(
+		MOVE_FORWARD | MOVE_BACK | MOVE_TURN_LEFT | MOVE_TURN_RIGHT | MOVE_UP | MOVE_DOWN | MOVE_LEFT | MOVE_RIGHT))
+		return false;
+	_modernActor = avatar->getObjId();
+	Kernel *kernel = Kernel::get_instance();
+	ActorAnimProcess *owned = dynamic_cast<ActorAnimProcess *>(kernel->getProcess(_modernAnimation));
+	if (!owned || owned->is_terminated()) {
+		_modernAnimation = 0;
+		owned = nullptr;
+	}
+	ActorAnimProcess *running = dynamic_cast<ActorAnimProcess *>(kernel->findProcess(
+		avatar->getObjId(), ActorAnimProcess::ACTOR_ANIM_PROC_TYPE));
+	if (running && !owned && running->getAction() != Animation::attack &&
+		running->getAction() != Animation::kneelAndFire && running->getAction() != Animation::reloadSmallWeapon)
+		return true;
+	int32 angle = getTwinStickAimAngle();
+	Direction aimDirection = static_cast<Direction>(CruTwinStickMath::bodyDirection(angle, false));
+	if ((aiming || hasMovementFlags(MOVE_ATTACKING)) && !avatar->isInCombat())
+		avatar->setInCombat(0);
+	_avatarAngle = avatar->isInCombat() ? angle : -1;
+	Animation::Sequence pose = avatar->isInCombat() ? Animation::advance : Animation::walk;
+	if (avatar->isKneeling()) {
+		pose = Animation::kneelingAdvance;
+	} else if (hasMovementFlags(MOVE_RUN)) {
+		pose = avatar->isInCombat() ? Animation::combatRunSmallWeapon : Animation::run;
+	} else if (aiming && moving) {
+		int32 moveAngle = CruTwinStickMath::aimAngle(_stick.getX(), _stick.getY());
+		int relative = (CruTwinStickMath::bodyDirection(moveAngle, false) - aimDirection + 16) % 16;
+		if (relative >= 6 && relative <= 10)
+			pose = Animation::retreat;
+		else if (relative >= 3 && relative <= 5)
+			pose = Animation::slideRight;
+		else if (relative >= 11 && relative <= 13)
+			pose = Animation::slideLeft;
+	}
+	Animation::Sequence idle = avatar->isKneeling() ? Animation::kneel :
+		avatar->isInCombat() ? Animation::combatStand : Animation::stand;
+	Direction facing = static_cast<Direction>(CruTwinStickMath::stableBodyDirection(angle,
+		avatar->animDirMode(moving ? pose : idle) == dirmode_8dirs, avatar->getDir()));
+	bool oneShot = hasMovementFlags(MOVE_ROLL_LEFT | MOVE_ROLL_RIGHT | MOVE_STEP_LEFT | MOVE_STEP_RIGHT |
+		MOVE_STEP_FORWARD | MOVE_STEP_BACK | MOVE_SHORT_JUMP | MOVE_TOGGLE_CROUCH);
+	bool fire = hasMovementFlags(MOVE_ATTACKING) && kernel->getTickNum() >= _nextFireTick;
+	if (owned && (!moving || owned->getAction() != pose || facing != avatar->getDir() || oneShot || fire)) {
+		stopModernAnimation();
+		owned = nullptr;
+	}
+	ActorAnimProcess *busy = dynamic_cast<ActorAnimProcess *>(kernel->findProcess(
+		avatar->getObjId(), ActorAnimProcess::ACTOR_ANIM_PROC_TYPE));
+	bool firing = busy && (busy->getAction() == Animation::attack || busy->getAction() == Animation::kneelAndFire ||
+		busy->getAction() == Animation::reloadSmallWeapon);
+	if (busy && !owned && !firing)
+		return true;
+	_modernWasActive = moving || aiming;
+	if (moving)
+		moveTwinStickActor(avatar);
+	if (avatar->getGravityPID())
+		return true;
+	if (busy)
+		return true;
+	bool turned = avatar->getDir() != facing;
+	avatar->setDir(facing);
+	if (checkOneShotMove(facing))
+		return true;
+	if (hasMovementFlags(MOVE_ATTACKING)) {
+		avatar->setDir(aimDirection);
+		tryAttack(false);
+		if (avatar->isBusy())
+			return true;
+	}
+	if (moving) {
+		_modernAnimation = avatar->doAnim(pose, facing);
+	} else if (avatar->getLastAnim() != idle || turned) {
+		avatar->setLastAnim(idle);
+		avatar->setToStartOfAnim(idle);
+	}
+	return true;
+}
