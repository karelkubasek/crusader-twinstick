+#ifndef ULTIMA8_WORLD_ACTORS_CRU_TWIN_STICK_MATH_H
+#define ULTIMA8_WORLD_ACTORS_CRU_TWIN_STICK_MATH_H
+
+#include "common/scummsys.h"
+#include "math/utils.h"
+
+namespace Ultima {
+namespace Ultima8 {
+
+class CruTwinStickMath {
+public:
+	static void movement(int x, int y, int speed, int32 &dx, int32 &dy) {
+		double length = sqrt(static_cast<double>(x) * x + static_cast<double>(y) * y);
+		if (!length) {
+			dx = dy = 0;
+			return;
+		}
+		double worldX = (x + 2.0 * y) / length * speed;
+		double worldY = (-x + 2.0 * y) / length * speed;
+		dx = static_cast<int32>(worldX + (worldX >= 0 ? 0.5 : -0.5));
+		dy = static_cast<int32>(worldY + (worldY >= 0 ? 0.5 : -0.5));
+	}
+
+	static int32 aimAngle(int x, int y) {
+		// Invert screen x=(worldX-worldY)/4, y=(worldX+worldY)/8.
+		double worldX = x + 2.0 * y;
+		double worldY = -x + 2.0 * y;
+		if (!x && !y)
+			return 0;
+		double angle = Math::rad2deg(atan2(worldX, -worldY));
+		if (angle < 0)
+			angle += 360;
+		return static_cast<int32>(angle * 100 + 0.5) % 36000;
+	}
+
+	static int bodyDirection(int32 angle, bool eightDirections) {
+		return eightDirections ? ((angle + 2250) / 4500 * 2) % 16 :
+			((angle + 1125) / 2250) % 16;
+	}
+};
+
+} // End of namespace Ultima8
+} // End of namespace Ultima
+
+#endif
