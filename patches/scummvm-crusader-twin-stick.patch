+void CruAvatarMoverProcess::stopModernAnimation() {
+	Process *process = Kernel::get_instance()->getProcess(_modernAnimation);
+	ActorAnimProcess *animation = dynamic_cast<ActorAnimProcess *>(process);
+	if (animation && !animation->is_terminated() && animation->getItemNum() == _modernActor &&
+		(animation->getAction() == Animation::walk || animation->getAction() == Animation::run ||
+		 animation->getAction() == Animation::advance || animation->getAction() == Animation::kneelingAdvance ||
+		 animation->getAction() == Animation::retreat || animation->getAction() == Animation::kneelingRetreat ||
+		 animation->getAction() == Animation::slideLeft || animation->getAction() == Animation::slideRight ||
+		 animation->getAction() == Animation::combatRunSmallWeapon)) {
+		animation->terminate();
+	}
+	_modernAnimation = 0;
+}
