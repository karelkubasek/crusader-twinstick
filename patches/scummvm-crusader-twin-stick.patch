@@ -0,0 +1,98 @@
+#include <cxxtest/TestSuite.h>
+#include "engines/ultima/ultima8/world/actors/cru_stick_input.h"
+
+class CruStickInputTestSuite : public CxxTest::TestSuite {
+public:
+	void testActivationOnlyHasNoUnusedWalkingThreshold() {
+		Ultima::Ultima8::CruStickInput stick(98, 100, 30, false);
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 32767);
+		TS_ASSERT(stick.isActive());
+		TS_ASSERT(!stick.isWalking());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 25000);
+		TS_ASSERT(stick.isActive());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 17000);
+		TS_ASSERT(!stick.isActive());
+	}
+
+	void testFaceWithoutWalkingThenStartWalking() {
+		Ultima::Ultima8::CruStickInput stick;
+		stick.update(Ultima::Ultima8::CruStickInput::LEFT, 4000);
+		TS_ASSERT(!stick.isActive());
+		stick.update(Ultima::Ultima8::CruStickInput::LEFT, 7000);
+		TS_ASSERT(stick.isActive());
+		TS_ASSERT(!stick.isWalking());
+		TS_ASSERT_EQUALS(stick.getX(), -7000);
+		TS_ASSERT_EQUALS(stick.getY(), 0);
+		stick.update(Ultima::Ultima8::CruStickInput::LEFT, 18000);
+		TS_ASSERT(stick.isWalking());
+	}
+
+	void testSeparateEntryAndExitThresholds() {
+		Ultima::Ultima8::CruStickInput stick;
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 15000);
+		TS_ASSERT(stick.isWalking());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 14000);
+		TS_ASSERT(stick.isWalking());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 13000);
+		TS_ASSERT(!stick.isWalking());
+		TS_ASSERT(stick.isActive());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 4500);
+		TS_ASSERT(stick.isActive());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 3000);
+		TS_ASSERT(!stick.isActive());
+	}
+
+	void testDiagonalUsesRadialMagnitude() {
+		Ultima::Ultima8::CruStickInput stick;
+		stick.update(Ultima::Ultima8::CruStickInput::UP, 11000);
+		TS_ASSERT(!stick.isWalking());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 11000);
+		TS_ASSERT(stick.isWalking());
+		TS_ASSERT_EQUALS(stick.getX(), 11000);
+		TS_ASSERT_EQUALS(stick.getY(), -11000);
+	}
+
+	void testOppositeHalfAxisReleaseDoesNotCancelNewDirection() {
+		Ultima::Ultima8::CruStickInput stick;
+		stick.update(Ultima::Ultima8::CruStickInput::LEFT, 18000);
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 18000);
+		TS_ASSERT_EQUALS(stick.getX(), 18000);
+		stick.update(Ultima::Ultima8::CruStickInput::LEFT, 0);
+		TS_ASSERT_EQUALS(stick.getX(), 18000);
+		TS_ASSERT(stick.isWalking());
+	}
+
+	void testResetAndReleaseClearBothModes() {
+		Ultima::Ultima8::CruStickInput stick;
+		stick.update(Ultima::Ultima8::CruStickInput::DOWN, 32767);
+		stick.update(Ultima::Ultima8::CruStickInput::DOWN, 0);
+		TS_ASSERT(!stick.isActive());
+		TS_ASSERT(!stick.isWalking());
+		stick.update(Ultima::Ultima8::CruStickInput::LEFT, 20000);
+		stick.reset();
+		TS_ASSERT_EQUALS(stick.getX(), 0);
+		TS_ASSERT_EQUALS(stick.getY(), 0);
+		TS_ASSERT(!stick.isWalking());
+	}
+
+	void testFullDiagonalAndInvalidInputAreBounded() {
+		Ultima::Ultima8::CruStickInput stick;
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 50000);
+		stick.update(Ultima::Ultima8::CruStickInput::DOWN, 32767);
+		TS_ASSERT_EQUALS(stick.getX(), 32767);
+		TS_ASSERT(stick.isWalking());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, -1);
+		TS_ASSERT_EQUALS(stick.getX(), 0);
+	}
+
+	void testCustomThresholds() {
+		Ultima::Ultima8::CruStickInput stick(25, 70, 5);
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 7000);
+		TS_ASSERT(!stick.isActive());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 15000);
+		TS_ASSERT(stick.isActive());
+		TS_ASSERT(!stick.isWalking());
+		stick.update(Ultima::Ultima8::CruStickInput::RIGHT, 25000);
+		TS_ASSERT(stick.isWalking());
+	}
+};
