+Item *CruAvatarMoverProcess::getTwinStickTarget() const {
+	Actor *avatar = getControlledActor();
+	if (!_twinStickControls || !avatar || avatar != getMainActor())
+		return nullptr;
+	Point3 pt = avatar->getLocation();
+	Direction dir = static_cast<Direction>(CruTwinStickMath::bodyDirection(getTwinStickAimAngle(), false));
+	return World::get_instance()->getCurrentMap()->findBestTargetItem(pt.x, pt.y, pt.z, dir, dirmode_16dirs);
+}
+
+bool CruAvatarMoverProcess::getTwinStickAimPoint(const Point3 &from, Point3 &to) const {
+	Actor *avatar = getControlledActor();
+	if (!_twinStickControls || !avatar || avatar != getMainActor())
+		return false;
+	int32 angle = getTwinStickAimAngle();
+	double radians = Math::deg2rad(angle / 100.0);
+	to = Point3(from.x + static_cast<int32>(400 * sin(radians)),
+		from.y - static_cast<int32>(400 * cos(radians)), from.z);
+	return true;
+}
