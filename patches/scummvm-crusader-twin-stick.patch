+bool CruAvatarMoverProcess::onAxisAction(KeybindingAction action, int16 position) {
+	if (!_modernControls)
+		return false;
+	CruStickInput::HalfAxis axis;
+	bool aim = false;
+	switch (action) {
+	case ACTION_STICK_LEFT: axis = CruStickInput::LEFT; break;
+	case ACTION_STICK_RIGHT: axis = CruStickInput::RIGHT; break;
+	case ACTION_STICK_UP: axis = CruStickInput::UP; break;
+	case ACTION_STICK_DOWN: axis = CruStickInput::DOWN; break;
+	case ACTION_AIM_LEFT: axis = CruStickInput::LEFT; aim = true; break;
+	case ACTION_AIM_RIGHT: axis = CruStickInput::RIGHT; aim = true; break;
+	case ACTION_AIM_UP: axis = CruStickInput::UP; aim = true; break;
+	case ACTION_AIM_DOWN: axis = CruStickInput::DOWN; aim = true; break;
+	default: return false;
+	}
+	if (aim && !_twinStickControls)
+		return false;
+	(aim ? _aimStick : _stick).update(axis, position == -32768 ? 32767 : position);
+	return true;
+}
